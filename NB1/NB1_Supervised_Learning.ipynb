        "# Prédictions sur tout le dataset\n",
        "df['conso_predite'] = gb.predict(df[FEATURES].values)\n",
        "df['pred_q10']      = gb_q10.predict(df[FEATURES].values)\n",
        "df['pred_q90']      = gb_q90.predict(df[FEATURES].values)\n",
        "df['hors_intervalle'] = (\n",
        "    (df['consommation_kwh'] < df['pred_q10']) |\n",
        "    (df['consommation_kwh'] > df['pred_q90'])\n",
        ").astype(int)\n",
        "df['ecart_pct'] = (\n",
        "    (df['consommation_kwh'] - df['conso_predite'])\n",
        "    / df['conso_predite'].clip(lower=0.1) * 100\n",
        ")\n",
        "\n",
        "# Modèles\n",
        "joblib.dump(gb,  'outputs/modele_lgbm.joblib',       compress=3)\n",

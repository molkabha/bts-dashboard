      "source": [
        "# Cellule 10 — Optimisation Optuna\n",
        "\n",
        "print('Optimisation Optuna (TPE, 50 essais, TimeSeriesSplit 3-fold sur train)...')\n",
        "\n",
        "def objective(trial):\n",
        "    params = {\n",
        "        'n_estimators'     : trial.suggest_int('n_estimators',       200, 600),\n",
        "        'learning_rate'    : trial.suggest_float('learning_rate',     0.01, 0.15, log=True),\n",
        "        'max_depth'        : trial.suggest_int('max_depth',           4, 12),\n",
        "        'num_leaves'       : trial.suggest_int('num_leaves',          31, 127),\n",
        "        'subsample'        : trial.suggest_float('subsample',         0.6, 1.0),\n",
        "        'colsample_bytree' : trial.suggest_float('colsample_bytree',  0.5, 1.0),\n",
        "        'min_child_samples': trial.suggest_int('min_child_samples',   10, 50),\n",
        "        'reg_alpha'        : trial.suggest_float('reg_alpha',         0.0, 1.0),\n",
        "        'reg_lambda'       : trial.suggest_float('reg_lambda',        0.0, 2.0),\n",
        "        'n_jobs': -1, 'random_state': 42, 'verbose': -1,\n",
        "    }\n",
        "    tscv_opt = TimeSeriesSplit(n_splits=3, gap=24)\n",
        "    scores = []\n",
        "    for tr_idx, val_idx in tscv_opt.split(X_train):\n",
        "        if len(tr_idx) < 500:\n",
        "            continue\n",
        "        try:\n",
        "            m = lgb.LGBMRegressor(**params)\n",
        "            m.fit(X_train[tr_idx], y_train[tr_idx],\n",
        "                  callbacks=[lgb.early_stopping(30, verbose=False), lgb.log_evaluation(-1)],\n",
        "                  eval_set=[(X_train[val_idx], y_train[val_idx])])\n",
        "            scores.append(np.clip(r2_score(y_train[val_idx], m.predict(X_train[val_idx])), -1, 1))\n",
        "        except Exception:\n",
        "            scores.append(-1.0)\n",
        "    return float(np.mean(scores)) if scores else -1.0\n",
        "\n",
        "t0 = time.time()\n",
        "study = optuna.create_study(direction='maximize', sampler=optuna.samplers.TPESampler(seed=42))\n",
        "study.optimize(objective, n_trials=50, show_progress_bar=False)\n",
        "print(f'Durée : {time.time()-t0:.0f}s | Meilleur R² CV : {study.best_value:.4f}')\n",
        "print('Meilleurs hyperparamètres :')\n",
        "for k, v in study.best_params.items():\n",
        "    print(f'  {k:<22} : {v}')\n",
        "\n",
        "# Entraînement final avec hyperparamètres optimaux\n",
        "print('\\nEntraînement LightGBM (hyperparamètres optimaux)...')\n",
        "gb_opt = lgb.LGBMRegressor(**{**study.best_params, 'n_jobs': -1, 'random_state': 42, 'verbose': -1})\n",
        "gb_opt.fit(X_train, y_train)\n",
        "y_pred_opt = gb_opt.predict(X_test)\n",
        "r2_opt = r2_score(y_test, y_pred_opt)\n",
        "\n",
        "print(f'  LightGBM manuel  : R²={r2_gb:.4f}')\n",
        "print(f'  LightGBM Optuna  : R²={r2_opt:.4f}  (gain = {r2_opt-r2_gb:+.4f})')\n",
        "\n",
        "if r2_opt >= r2_gb:\n",
        "    gb = gb_opt; y_pred_gb = y_pred_opt; r2_gb = r2_opt\n",
        "    mae_gb = mean_absolute_error(y_test, y_pred_gb)\n",
        "    rmse_pct_gb = np.sqrt(mean_squared_error(y_test, y_pred_gb)) / y_test.mean() * 100\n",
        "    resultats_modeles['LightGBM']['r2'] = r2_gb\n",
        "    print(' Modèle Optuna retenu')\n",
        "else:\n",
        "    print(' Modèle manuel conservé')\n"
      ]
    },

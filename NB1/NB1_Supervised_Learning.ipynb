        "# Cellule 13 — Stacking niveau 2 : correcteurs par station\n",
        "\n",
        "print('STACKING NIVEAU 2 — Correcteurs Ridge par Station ')\n",
        "print('(entraînés sur prédictions OOF pour éviter le data leakage)\\n')\n",
        "\n",
        "# Préparation données enrichies\n",
        "df_ml2_train = df[df['annee'] < 2026].copy()\n",
        "df_ml2_train = df_ml2_train[\n",
        "    (df_ml2_train[TARGET] >= q_low) & (df_ml2_train[TARGET] <= q_high)\n",
        "].reset_index(drop=True)\n",
        "df_ml2_test = df[df['annee'] == 2026].copy().reset_index(drop=True)\n",
        "\n",
        "for col in FEATURES_V2:\n",
        "    med = df_ml2_train[col].median()\n",
        "    df_ml2_train[col] = df_ml2_train[col].fillna(med)\n",
        "    df_ml2_test[col]  = df_ml2_test[col].fillna(med)\n",
        "\n",
        "X2_train = df_ml2_train[FEATURES_V2].values\n",
        "y2_train = df_ml2_train[TARGET].values\n",
        "X2_test  = df_ml2_test[FEATURES_V2].values\n",
        "y2_test  = df_ml2_test[TARGET].values\n",
        "\n",
        "# Niveau 1 : modèle global sur features enrichies\n",
        "gb2 = lgb.LGBMRegressor(n_estimators=300, learning_rate=0.05, max_depth=8, num_leaves=63,\n",
        "                          subsample=0.8, colsample_bytree=0.8, min_child_samples=20,\n",
        "                          reg_alpha=0.1, reg_lambda=1.0, n_jobs=-1, random_state=42, verbose=-1)\n",
        "\n",
        "# Prédictions OOF (out-of-fold)\n",
        "tscv_stack      = TimeSeriesSplit(n_splits=5)\n",
        "oof_preds_train = np.zeros(len(X2_train))\n",
        "for tr_idx, val_idx in tscv_stack.split(X2_train):\n",
        "    m_fold = lgb.LGBMRegressor(n_estimators=300, learning_rate=0.05, max_depth=8, num_leaves=63,\n",
        "                                subsample=0.8, colsample_bytree=0.8, min_child_samples=20,\n",
        "                                reg_alpha=0.1, reg_lambda=1.0, n_jobs=-1, random_state=42, verbose=-1)\n",
        "    m_fold.fit(X2_train[tr_idx], y2_train[tr_idx])\n",
        "    oof_preds_train[val_idx] = m_fold.predict(X2_train[val_idx])\n",
        "\n",
        "gb2.fit(X2_train, y2_train)\n",
        "pred_base_test = gb2.predict(X2_test)\n",
        "r2_v2 = r2_score(y2_test, pred_base_test)\n",
        "print(f'R² modèle global v2 : {r2_v2:.4f}')\n",
        "\n",
        "df_ml2_train['pred_base'] = oof_preds_train\n",
        "df_ml2_test['pred_base']  = pred_base_test\n",
        "\n",
        "# Niveau 2 : correcteurs Ridge par station\n",
        "correcteurs   = {}\n",
        "preds_finales = np.zeros(len(df_ml2_test))\n",
        "stations_liste = df_ml2_train['station_id'].unique()\n",
        "\n",
        "for station_id in stations_liste:\n",
        "    mask_tr = df_ml2_train['station_id'] == station_id\n",
        "    idx_te  = np.where(df_ml2_test['station_id'].values == station_id)[0]\n",
        "    if mask_tr.sum() < 48:\n",
        "        correcteurs[station_id] = None\n",
        "        if len(idx_te) > 0:\n",
        "            preds_finales[idx_te] = df_ml2_test.iloc[idx_te]['pred_base'].values\n",
        "        continue\n",
        "    X_corr_tr = df_ml2_train.loc[mask_tr, ['pred_base', 'conso_moy_24h', 'eei']].values\n",
        "    y_corr_tr = df_ml2_train.loc[mask_tr, TARGET].values\n",
        "    corr = Ridge(alpha=10.0)\n",
        "    corr.fit(X_corr_tr, y_corr_tr)\n",
        "    correcteurs[station_id] = corr\n",
        "    if len(idx_te) > 0:\n",
        "        preds_finales[idx_te] = corr.predict(\n",
        "            df_ml2_test.iloc[idx_te][['pred_base', 'conso_moy_24h', 'eei']].values\n",
        "        )\n",
        "\n",
        "r2_final   = r2_score(y2_test, preds_finales)\n",
        "rmse_final = np.sqrt(mean_squared_error(y2_test, preds_finales))\n",
        "rmse_pct_final = rmse_final / y2_test.mean() * 100\n",
        "\n",
        "print(f'\\n RÉSULTATS FINAUX')\n",
        "print(f'  LightGBM v1  (baseline)           R²={r2_gb:.4f}')\n",
        "print(f'  LightGBM v2  (features enrichies)  R²={r2_v2:.4f}')\n",
        "print(f'  LightGBM v2+ (+ correcteurs OOF)   R²={r2_final:.4f}  RMSE={rmse_pct_final:.1f}%')\n",
        "print(f'  Gain total R² : +{r2_final-r2_gb:.4f}')\n",
        "print(f'  Objectif R² ≥ 0.85 : {\" ATTEINT\" if r2_final >= 0.85 else \" NON ATTEINT\"}')\n",
        "print(f'  Objectif RMSE ≤ 15% : {\" ATTEINT\" if rmse_pct_final <= 15 else \" NON ATTEINT\"}')\n"

      "source": [
        "# Cellule 2 — Fonctions de prétraitement\n",
        "\n",
        "def nettoyer(df: pd.DataFrame) -> pd.DataFrame:\n",
        "    \"\"\"Supprime les lignes physiquement incohérentes (capteurs défaillants).\"\"\"\n",
        "    # Vérification des bornes physiques des colonnes météo (ETSI EN 300 019)\n",
        "    # Humidité : 0-100%, vent >= 0, rayonnement >= 0, pression entre 950 et 1060 hPa\n",
        "    masque_meteo = (\n",
        "        (df['humidite_relative_pct'].fillna(50).between(0, 100)) &\n",
        "        (df['vitesse_vent_ms'].fillna(0).ge(0)) &\n",
        "        (df['rayonnement_solaire_wm2'].fillna(0).ge(0)) &\n",
        "        (df['precipitation_mmh'].fillna(0).ge(0)) &\n",
        "        (df['pression_atmospherique_hpa'].fillna(1013).between(950, 1060)) &\n",
        "        (df['indice_uv'].fillna(0).between(0, 12))\n",
        "    )\n",
        "    masque = masque_meteo & (\n",
        "        (df['consommation_kwh'] > 0) &\n",
        "        (df['charge_cpu_pct'].fillna(50).between(0, 100)) &\n",
        "        (df['temperature_ambiante'].fillna(20).between(-20, 60))\n",
        "    )\n",
        "    n_sup = (~masque).sum()\n",
        "    print(f'  Lignes supprimées (incohérences physiques) : {n_sup:,}')\n",
        "    return df[masque].copy()\n",
        "\n",
        "\n",
        "def imputer(df: pd.DataFrame, df_train_ref: pd.DataFrame) -> pd.DataFrame:\n",
        "    \"\"\"Impute les NaN par la médiane contextuelle calculée sur le train.\"\"\"\n",
        "    # Colonnes originales avec NaN potentiels\n",
        "    cols = ['trafic_voix_erlang', 'trafic_data_mbps',\n",
        "            'charge_cpu_pct', 'temperature_ambiante',\n",
        "            # Colonnes météo ajoutées — imputation par médiane contextuelle (heure, type_zone)\n",
        "            'humidite_relative_pct', 'vitesse_vent_ms', 'rayonnement_solaire_wm2',\n",
        "            'precipitation_mmh', 'pression_atmospherique_hpa', 'indice_uv']\n",
        "    for col in cols:\n",
        "        n_nan = df[col].isnull().sum()\n",
        "        if n_nan == 0:\n",
        "            continue\n",
        "        med_ctx = df_train_ref.groupby(['heure', 'type_zone'])[col].median()\n",
        "        med_glob = df_train_ref[col].median()\n",
        "        df[col] = df[col].fillna(\n",
        "            df.apply(\n",
        "                lambda r: med_ctx.get((r['heure'], r['type_zone']), med_glob)\n",
        "                if pd.isna(r[col]) else r[col],\n",
        "                axis=1\n",
        "            )\n",
        "        )\n",
        "        print(f'  {col:30s} : {n_nan:,} NaN imputés')\n",
        "    return df\n",
        "\n",
        "\n",
        "def encoder_categoriel(df_train: pd.DataFrame, df_test: pd.DataFrame):\n",
        "    \"\"\"Encode les variables catégorielles (fit sur train uniquement).\"\"\"\n",
        "    le_tech = LabelEncoder().fit(df_train['technologie'])\n",
        "    le_zone = LabelEncoder().fit(df_train['type_zone'])\n",
        "    for subset in [df_train, df_test]:\n",
        "        subset['technologie_enc'] = le_tech.transform(subset['technologie'])\n",
        "        subset['type_zone_enc']   = le_zone.transform(subset['type_zone'])\n",
        "    return df_train, df_test, le_tech, le_zone\n",
        "\n",
        "\n",
        "print('Fonctions de prétraitement définies')\n"
      ]
    },

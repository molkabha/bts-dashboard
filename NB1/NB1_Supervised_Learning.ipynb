        "# Cellule 7 — Préparation des jeux train / test\n",
        "\n",
        "df_train_full = df[df['annee'] < 2026].copy()\n",
        "df_test_full  = df[df['annee'] == 2026].copy()\n",
        "\n",
        "# Seuils outliers calculés sur le train uniquement (anti-leakage)\n",
        "q_low  = df_train_full[TARGET].quantile(0.01)\n",
        "q_high = df_train_full[TARGET].quantile(0.99)\n",
        "print(f'Seuils outliers [train] : [{q_low:.3f} ; {q_high:.3f}] kWh')\n",
        "\n",
        "df_train = df_train_full[(df_train_full[TARGET] >= q_low) & (df_train_full[TARGET] <= q_high)].copy()\n",
        "df_test  = df_test_full.copy()\n",
        "\n",
        "X_train = df_train[FEATURES].values\n",
        "y_train = df_train[TARGET].values\n",
        "X_test  = df_test[FEATURES].values\n",
        "y_test  = df_test[TARGET].values\n",
        "\n",
        "print(f'\\nTrain 2022–2023 : {len(df_train):>10,} lignes')\n",
        "print(f'Test  2026      : {len(df_test):>10,} lignes')\n",
        "print(f'Contenu test : Ramadan={df_test[\"est_ramadan\"].sum():,} | Été={df_test[df_test[\"mois\"].between(6,9)].shape[0]:,} | Fériés={df_test[\"est_ferie\"].sum():,}')\n"

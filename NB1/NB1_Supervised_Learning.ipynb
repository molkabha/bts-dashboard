        "# Cellule 15 — Analyse SHAP\n",
        "\n",
        "print('Calcul valeurs SHAP (TreeExplainer — exact pour LightGBM)...')\n",
        "N_SHAP   = min(2000, len(X_test))\n",
        "idx_shap = np.random.RandomState(42).choice(len(X_test), N_SHAP, replace=False)\n",
        "X_shap   = X_test[idx_shap]\n",
        "\n",
        "explainer   = shap.TreeExplainer(gb)\n",
        "shap_values = explainer.shap_values(X_shap)\n",
        "\n",
        "mean_abs_shap = np.abs(shap_values).mean(axis=0)\n",
        "feat_order    = np.argsort(mean_abs_shap)\n",
        "TOP_N = 15\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(16, 7))\n",
        "fig.suptitle('Interprétabilité SHAP — LightGBM (Lundberg & Lee, NeurIPS 2017)',\n",
        "             fontsize=12, fontweight='bold')\n",
        "\n",
        "# Beeswarm\n",
        "top_idx  = feat_order[-TOP_N:]\n",
        "shap_top = shap_values[:, top_idx]\n",
        "x_top    = X_shap[:, top_idx]\n",
        "for j in range(TOP_N):\n",
        "    jitter = np.random.RandomState(j).uniform(-0.3, 0.3, N_SHAP)\n",
        "    x_col  = x_top[:, j]\n",
        "    p5, p95 = np.nanpercentile(x_col, [5, 95])\n",
        "    x_norm  = np.clip((x_col - p5) / (p95 - p5 + 1e-9), 0, 1)\n",
        "    axes[0].scatter(shap_top[:, j], j + jitter, c=x_norm, cmap='coolwarm', alpha=0.25, s=5)\n",
        "axes[0].set_yticks(range(TOP_N)); axes[0].set_yticklabels([FEATURES[i] for i in top_idx], fontsize=8)\n",
        "axes[0].axvline(0, color='black', lw=1)\n",
        "axes[0].set_xlabel('Valeur SHAP (contribution kWh)')\n",
        "axes[0].set_title(f'Beeswarm — Top {TOP_N} Features', fontweight='bold')\n",
        "\n",
        "# Bar chart importance SHAP\n",
        "shap_imp = pd.Series(mean_abs_shap, index=FEATURES).sort_values()\n",
        "thresh   = shap_imp.quantile(0.80)\n",
        "colors_s = ['#e74c3c' if v >= thresh else '#3498db' for v in shap_imp.values]\n",
        "axes[1].barh(shap_imp.index, shap_imp.values, color=colors_s)\n",
        "axes[1].set_title('Importance SHAP Moyenne |E[|SHAP|]|', fontweight='bold')\n",

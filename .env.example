# Environment (development / production)
ENVIRONMENT=development
DEBUG=False

# Security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=temporary-secret-key-for-dev

# Default admin bootstrap.
# Leave ADMIN_PASSWORD empty in committed examples. Set a strong value only in
# your private .env or provide ADMIN_PASSWORD_HASH.
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_EMAIL=admin@tt.tn

# Database
# DB_PATH=C:\Users\User\Desktop\nb2_v2\dashboard_project\dashboard_ops.sqlite3

# Hugging Face Hub integration. Local VF artefacts remain the offline fallback.
USE_HF_HUB=True
HF_REPO_ID=molkab/dashboard
# Optionnel si depot prive ou quotas Hub eleves (aussi dans Streamlit Secrets : HF_TOKEN)
# HF_TOKEN=your_hf_token_if_private_repo

# Trusted proxies when deployed behind a reverse proxy
TRUSTED_PROXIES=127.0.0.1

# SMTP for account emails
BTS_SMTP_HOST=
BTS_SMTP_PORT=587
BTS_SMTP_USER=
BTS_SMTP_PASSWORD=
BTS_SMTP_FROM=
BTS_SMTP_STARTTLS=1
BTS_SMTP_VERIFY_SSL=1

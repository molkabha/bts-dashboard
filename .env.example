# Environnement (development / production)
ENVIRONMENT=development
DEBUG=False

# Sécurité
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=temporary-secret-key-for-dev

# Identifiants Admin par défaut
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@tt.tn

# Redis (Obligatoire en production pour le rate limiting)
REDIS_ENABLED=False
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Base de données
# DB_PATH=C:\Users\User\Desktop\nb2_v2\dashboard_ops.sqlite3

# Proxies de confiance (si derrière un reverse proxy)
TRUSTED_PROXIES=127.0.0.1

# --- SMTP (pour envoyer les emails d'accès ingénieur) ---
# Le code attend au minimum BTS_SMTP_HOST, BTS_SMTP_FROM (ou BTS_SMTP_USER),
# et BTS_SMTP_VERIFY_SSL != 0/false/no.
#
# Exemples :
# BTS_SMTP_HOST=smtp.votre-domaine.tn
# BTS_SMTP_PORT=587
# BTS_SMTP_USER=admin@votre-domaine.tn
# BTS_SMTP_PASSWORD=XXXXXXXX
# BTS_SMTP_FROM=admin@votre-domaine.tn
# BTS_SMTP_STARTTLS=1
# BTS_SMTP_VERIFY_SSL=1

BTS_SMTP_HOST=
BTS_SMTP_PORT=587
BTS_SMTP_USER=
BTS_SMTP_PASSWORD=
BTS_SMTP_FROM=
BTS_SMTP_STARTTLS=1
BTS_SMTP_VERIFY_SSL=1

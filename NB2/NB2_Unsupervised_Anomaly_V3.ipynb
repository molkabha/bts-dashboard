        "mask_type1 = mask_conso_elevee & mask_ecart_eleve\n",
        "mask_type2 = mask_qos_degrade  & ~mask_conso_elevee\n",
        "mask_type3 = mask_conso_elevee & mask_qos_degrade\n",
        "\n",
        "types_par_modele = {}\n",
        "for nom, lbl in anomalie_labels.items():\n",

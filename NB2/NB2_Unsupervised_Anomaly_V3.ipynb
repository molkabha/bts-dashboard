        "    'train': scores_ae[:len(X_tr_std)],\n",
        "    'test':  scores_ae[len(X_tr_std):],\n",
        "}\n",
        "anomalie_labels[AE_KEY] = labels_ae\n",
        "print(f'[AE]  {time.time()-t0:.1f}s  |  anomalies : {labels_ae.sum():,} ({labels_ae.mean()*100:.1f}%)')"
